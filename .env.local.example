# Copy to .env.local (gitignored) and fill in real values — never commit actual secrets.
#
# Every variable the code reads is listed here (REVIEW.md R-17): two of them
# were only ever set in the Vercel dashboard, so nothing in the repository
# said they existed or what breaks without them.

# --- Required: the app cannot score anything without these ---------------

# Firebase Admin SDK — Firebase console → Project settings → Service accounts
# → Generate new private key. Paste the private_key field as-is (it already
# contains literal \n sequences; keep them, don't unescape them yourself).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini API key — https://aistudio.google.com/apikey
# Sent as an `x-goog-api-key` header, never in a URL (see lib/gemini/client.ts).
# Only the Deep dive uses it; Quick results are a deterministic lookup.
GEMINI_API_KEY=

# --- Required in production for the features they gate -------------------

# Gates /admin/stats via HTTP Basic Auth in proxy.ts. FAILS CLOSED: if this is
# unset, the dashboard returns 401 to everyone, including you. That is the
# intended default, but it does mean the route stays shut until it is set in
# the Vercel project's environment variables.
ADMIN_DASHBOARD_PASSWORD=

# GoatCounter API token with the "read stats" permission only, generated in
# GoatCounter's Settings → API. Powers the funnel section of /admin/stats.
# Without it that section renders "Unavailable — ..." and the rest of the
# dashboard still works.
GOATCOUNTER_API_TOKEN=

# --- Optional -------------------------------------------------------------

# GoatCounter site code — https://www.goatcounter.com (free, cookie-less
# analytics). "myproject" for a site at myproject.goatcounter.com. Without it
# the tracking script is simply not injected and every custom event no-ops:
# no broken request, no console noise, no consent banner either way.
NEXT_PUBLIC_GOATCOUNTER_CODE=

# Canonical site URL used for OG images, canonical and hreflang tags (no
# trailing slash). Defaults to https://tourdegrowth.com when unset.
NEXT_PUBLIC_SITE_URL=

# --- Optionnel ---
# Ouvre la page publique /metrics (REVIEW-02.md R2-28). Absente ou différente
# de "true", la page répond 404 : c'est le défaut voulu tant que les chiffres
# ne valent pas la peine d'être lus. Lue à chaque requête, donc la basculer
# dans Vercel ouvre ou ferme la page sans redéploiement. Un second garde-fou
# vit dans le code : sous 50 Tours, la page s'affiche mais dit qu'il est trop
# tôt plutôt que de publier des ratios calculés sur rien.
METRICS_PAGE_ENABLED=
