# Copy to .env.local (gitignored) and fill in real values — never commit actual secrets.
#
# Every variable the code reads is listed here (REVIEW.md R-17): two of them
# were only ever set in the Vercel dashboard, so nothing in the repository
# said they existed or what breaks without them. The app's variables come
# first; the ones only tests, probes and scripts read are at the end.

# --- Required: the app cannot score anything without these ---------------

# Firebase Admin SDK — Firebase console → Project settings → Service accounts
# → Generate new private key. Paste the private_key field as-is (it already
# contains literal \n sequences; keep them, don't unescape them yourself).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini API key — https://aistudio.google.com/apikey
# Sent as an `x-goog-api-key` header, never in a URL (see lib/gemini/client.ts).
# Only the Deep dive uses it; Quick results are a deterministic lookup.
GEMINI_API_KEY=

# --- Required in production for the features they gate -------------------

# Gates every /admin route (stats, preview, audit) via HTTP Basic Auth in
# proxy.ts, and signs the owner-preview cookie of /admin/preview
# (src/lib/owner-preview.ts). FAILS CLOSED: if this is unset, /admin returns
# 401 to everyone, including you. That is the intended default, but it does
# mean the routes stay shut until it is set in the Vercel project's
# environment variables.
ADMIN_DASHBOARD_PASSWORD=

# GoatCounter API token with the "read stats" permission only, generated in
# GoatCounter's Settings → API. Powers the funnel section of /admin/stats.
# Without it that section renders "Unavailable — ..." and the rest of the
# dashboard still works.
GOATCOUNTER_API_TOKEN=

# --- Optional -------------------------------------------------------------

# GoatCounter site code — https://www.goatcounter.com (free, cookie-less
# analytics). "myproject" for a site at myproject.goatcounter.com. Without it
# the tracking script is simply not injected and every custom event no-ops:
# no broken request, no console noise, no consent banner either way.
NEXT_PUBLIC_GOATCOUNTER_CODE=

# Canonical site URL used for OG images, canonical and hreflang tags (no
# trailing slash). Defaults to https://tourdegrowth.com when unset.
NEXT_PUBLIC_SITE_URL=

# --- Optionnel ---
# Ouvre la page publique /metrics (REVIEW-02.md R2-28). Absente ou différente
# de "true", la page répond 404 : c'est le défaut voulu tant que les chiffres
# ne valent pas la peine d'être lus. Lue à chaque requête, mais sur Vercel
# une variable modifiée n'atteint que les nouveaux déploiements : l'ouvrir ou
# la fermer demande un redéploiement. Un second garde-fou
# vit dans le code : sous 50 Tours, la page s'affiche mais dit qu'il est trop
# tôt plutôt que de publier des ratios calculés sur rien.
METRICS_PAGE_ENABLED=

# Ouvre le jeu « Le côté obscur » (/{locale}/game, GAME-BRIEF.md §13). Absente
# ou différente de "true", ses pages répondent 404. Lue à chaque requête par
# le proxy et la page de résultat ; le sitemap, le hreflang et le lien de pied
# de page suivent la valeur au moment du build. Sur Vercel, toute modification
# (ouvrir comme fermer en urgence) = poser la variable puis redéployer. Pour tester en production pendant que c'est fermé :
# /admin/preview (derrière ADMIN_DASHBOARD_PASSWORD), bouton « Ouvrir sur ce
# navigateur » — un cookie signé avec ce mot de passe, que personne d'autre ne
# peut fabriquer (src/lib/owner-preview.ts). Changer le mot de passe les révoque tous.
GAME_ENABLED=

# Ouvre le moteur de growth (/{locale}/aarrr-funnel-template, ENGINE.md
# §11.2). Même contrat que GAME_ENABLED : absente ou différente de
# "true", la page répond 404. Lue à chaque requête par le proxy ; le noindex
# de la page, le sitemap et les liens entrants suivent la valeur au moment du
# build, donc ouvrir pour de bon = poser la variable puis redéployer. Reste
# fermée jusqu'à ce que CHANTIERS.md D2 soit prêt (le bon à tirer nº8 et tout
# le lot A7.3, le B2B assisté). Pour tester en production pendant que
# c'est fermé : /admin/preview, comme pour le jeu (cookie signé, ce navigateur
# seulement).
ENGINE_ENABLED=

# Les types d'entreprise ouverts en plus du SaaS B2B (§21.3), séparés par
# des virgules : consumer-app, puis marketplace. Vide : le SaaS B2B seul.
ENGINE_TYPES=

# --- Outils, tests et sondes : jamais lus par l'application ----------------

# Port du serveur que Playwright démarre (3210 par défaut), pour que deux
# copies du dépôt ne se servent pas l'une l'autre leur build.
E2E_PORT=

# Adresse de l'émulateur Firestore (par exemple 127.0.0.1:8080). Posée, les
# specs d'un vrai /r/<id> écrivent puis lisent leurs résultats dedans ; absente,
# elles sautent avec leur raison. Recette locale : TESTING.md §5.
FIRESTORE_EMULATOR_HOST=

# Site visé par la sonde de production (scripts/live/production.live.ts),
# https://www.tourdegrowth.com par défaut.
VERIFY_SITE_URL=

# Site visé par les captures du kit (scripts/kit-screenshots.mjs et
# scripts/kit-capture.config.ts), http://localhost:3000 par défaut.
SITE=

# Rapport Search Console (scripts/gsc-report.mjs). Ne se posent pas ici : ce
# sont des secrets du workflow stats.yml, qui chiffre ce qu'il lit (GITHUB.md
# §1.5). Le JSON du compte de service, et la propriété à lire.
# GSC_SERVICE_ACCOUNT_JSON=
# GSC_SITE=
