# Next.js
/.next/
/out/

# Vercel CLI Build Output (`vercel build`, run offline to measure function
# weight — see CLAUDE.md). It is build output like /.next/, and its minified
# bundles also make ESLint report ~2,300 phantom problems if it is left in
# the tree, so it is ignored by eslint.config.mjs too.
/.vercel/

# Dependencies
/node_modules/

# Env
.env
.env.local
.env*.local

# Build
/build
/dist/
*.tsbuildinfo
next-env.d.ts

# Misc
.DS_Store
*.log
npm-debug.log*

# Vitest / coverage
/coverage

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# design-sync (claude.ai/design) — staged scripts, generated bundle, machine state.
# The durable inputs under .design-sync/ (config.json, NOTES.md, conventions.md,
# previews/, overrides/) ARE committed; everything below is regenerated.
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules

# Claude Code — per-machine settings and the git worktrees its workflows create
/.claude/settings.local.json
/.claude/worktrees/
